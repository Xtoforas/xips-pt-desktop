{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xips-pt desktop",
  "version": "0.1.4",
  "identifier": "com.xips.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "xips-pt desktop",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMEEyQzAyRjgwOUIxNTYKUldSV3NRbjRBaXdLSURyV0tuaHlzL3VzakwvdEJVMFdqUFUwZFY3SG43VDdvb3Q4bDhTMlAwL3AK",
      "endpoints": [
        "https://github.com/Xtoforas/xips-pt-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
